{
  "key": "{n}",
  "tasks": {
    "_start_": {
      "next": { "pr.approved": "merge" }
    },
    "merge": {
      "actions": [
        {
          "type": "prompt",
          "agent": "meme",
          "text": "Merge pull request {pr.url} through the queue."
        }
      ],
      "limit": { "turn": 1, "time": 1800 },
      "next": { "pr.merged": "_done_" }
    }
  }
}
